    },
    {
      "url": "https://github.com/r5py/r5/blob/v7.5.1-r5py/src/main/java/com/conveyal/r5/streets/EdgeStore.java",
      "finding": "Edge.getEnvelope uses fixed-coordinate points, matching IntHashGrid Envelope inputs."
    },
    {
      "url": "https://github.com/r5py/r5/blob/v7.5.1-r5py/src/main/java/com/conveyal/r5/streets/StreetLayer.java",
      "finding": "indexStreets calls the affected LineString overload. findSplit queries candidates through the derived index."
    },
    {
      "url": "https://github.com/r5py/r5/blob/v7.5.1-r5py/src/main/java/com/conveyal/r5/streets/StreetRouter.java",
      "finding": "Destination getState(Split) adds the along-edge partial distance but omits distanceToEdge_mm. The corrected index makes the fixed destination lie on the selected edge, with zero off-edge offset."
    }
